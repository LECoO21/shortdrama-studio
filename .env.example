# 本地编辑和预处理无需 Key。ChatGPT 通过官方登录连接，不在此处填写token。
# 停用旧百炼默认方向；连接账号不会自动发起分析或购买额外额度。
STUDIO_MODEL_PROVIDER=chatgpt
# 支持单行 KEY=value 和配对引号；不执行 shell 表达式，不插值 $变量。
# 相对路径相对于项目根目录；本目录存数据库、原片与渲染产物。
STUDIO_DATA_DIR=./data
# 已安装工具名称或绝对路径；不自动下载系统工具。
FFMPEG_BIN=ffmpeg
# 可选：中文字体绝对路径。本机自动使用系统字体；Linux 需安装有许可的 Noto CJK。
# STUDIO_FONT_FILE=/absolute/path/NotoSansCJK-Regular.ttc
# 仅此公开地址可进入浏览器，禁止在 NEXT_PUBLIC_* 中放密钥。
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8031
NEXT_TELEMETRY_DISABLED=1

# 以下仅保留旧百炼适配的兼容配置，当前默认不使用，不需要填写。
# 即使旧Key/开关仍存在，也不会在chatgpt模式下启用它。
STUDIO_MODELS_ENABLED=0
DASHSCOPE_API_KEY=
# 可选：百炼北京业务空间 ID，空值使用官方 dashscope.aliyuncs.com。
STUDIO_BAILIAN_WORKSPACE_ID=
STUDIO_ASR_MODEL=paraformer-v2
STUDIO_VISION_MODEL=qwen3-vl-plus
STUDIO_EMBEDDING_MODEL=text-embedding-v4
STUDIO_MODEL_TIMEOUT_SECONDS=60
# ASR 是异步录音文件接口，需要厂商可读取的已授权 HTTPS 链接。
# 不创建 OSS、不自动上传。由部署者将本地 analysis 目录中的16k单声道audio.wav
# 放入受控临时存储。链接必须对应提取文件，不能填写原MP4或另一段音频。
# 只填可信受控域名，多个以逗号分隔；链接本身可能含秘密，不提交、不打印。
STUDIO_ASR_AUDIO_HOSTS=
# 私有 JSON 映射：素材ID -> {url:HTTPS链接,audio_sha256:提取WAV的SHA256,asset_version:版本号}
# hash与版本由后端核对；通过安全本地编辑填写真实JSON，勿粘贴到聊天。
STUDIO_ASR_AUDIO_URLS_JSON={}
